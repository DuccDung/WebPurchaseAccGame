@model SystemPurchaseAccGame.Models.ViewModels.LuckyImageIndexVm

@{
    ViewData["Title"] = "Quản lý ảnh vòng quay may mắn";
}

<h2>Quản lý ảnh vòng quay may mắn</h2>

@if (TempData["ok"] != null)
{
    <div style="padding:10px;border:1px solid #b7f0c2;background:#eaffe9;margin:10px 0;">
        @TempData["ok"]
    </div>
}
@if (TempData["err"] != null)
{
    <div style="padding:10px;border:1px solid #ffb7b7;background:#ffecec;margin:10px 0;">
        @TempData["err"]
    </div>
}

<p style="color:#555;">
    Ảnh được lưu tại: <b>wwwroot/img/lucky</b><br />
    Tên ảnh cố định theo slot: <b>ID_01</b> → <b>ID_09</b> (hệ thống tự thêm đuôi .png/.jpg/.jpeg/.webp).
</p>

<div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:16px;">
    @foreach (var s in Model.Slots)
    {
        <div style="border:1px solid #ddd; border-radius:10px; padding:12px;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <h4 style="margin:0;">Vị trí #@s.Slot</h4>
                <span style="font-size:12px;color:#666;">@s.FileKey</span>
            </div>

            @if (s.Exists)
            {
                <div style="margin:10px 0;">
                    <img src="@s.Url" alt="Lucky @s.FileKey"
                         style="width:100%; height:180px; object-fit:cover; border-radius:8px; border:1px solid #eee;" />
                    <div style="font-size:12px; color:#666; margin-top:6px;">
                        Url: @s.Url
                    </div>
                </div>
            }
            else
            {
                <div style="margin:10px 0; padding:12px; background:#fafafa; border:1px dashed #ccc; border-radius:8px;">
                    Chưa có ảnh ở vị trí này.
                </div>
            }

            <!-- Upload / Replace -->
            <form asp-action="UploadLuckyImage" method="post" enctype="multipart/form-data" style="margin-top:10px;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="slot" value="@s.Slot" />

                <div style="margin-bottom:8px;">
                    <input type="file" name="file" accept="image/*" />
                </div>

                <button type="submit"
                        style="padding:6px 10px; border:1px solid #333; background:#fff; border-radius:6px; cursor:pointer;">
                    @(s.Exists ? "Thay ảnh" : "Thêm ảnh")
                </button>
            </form>

            <!-- Delete -->
            @if (s.Exists)
            {
                <form asp-action="DeleteLuckyImage" method="post" style="margin-top:10px;"
                      onsubmit="return confirm('Xoá ảnh vị trí #@s.Slot ?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="slot" value="@s.Slot" />
                    <button type="submit"
                            style="padding:6px 10px; border:1px solid #a00; color:#a00; background:#fff; border-radius:6px; cursor:pointer;">
                        Xoá ảnh
                    </button>
                </form>
            }
        </div>
    }
</div>