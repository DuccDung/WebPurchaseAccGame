@model SystemPurchaseAccGame.ViewModel.NeedTopupMultiVm
@using System.Globalization
@{
    var vi = new CultureInfo("vi-VN");
}

<div class="acc_detail_pay_modal" data-open="true" aria-hidden="false" role="dialog">
    <div class="acc_detail_pay_modalCard">
        <div class="acc_detail_pay_modalTop">
            <div class="acc_detail_pay_modalTitle">Số dư không đủ</div>
            <button class="acc_detail_pay_modalClose js-close-modal" type="button" aria-label="Đóng">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="p-3">
            <div class="mb-2"><strong>@Model.GameName</strong></div>
            <div class="mb-1">Số lượng: <strong>@Model.Quantity</strong></div>
            <div class="mb-1">Tổng tiền: <strong class="text-danger">@Model.TotalPrice.ToString("N0", vi) ₫</strong></div>
            <div class="mb-1">Số dư hiện tại: <strong>@Model.Balance.ToString("N0", vi) ₫</strong></div>
            <div class="mb-3">Cần nạp thêm: <strong class="text-danger">@Model.NeedMore.ToString("N0", vi) ₫</strong></div>

            @if (!string.IsNullOrWhiteSpace(Model.QrImageUrl))
            {
                <div class="text-center mb-3">
                    <img src="@Model.QrImageUrl" alt="QR nạp tiền" style="max-width:320px;width:100%;border-radius:12px;border:1px solid #eee" />
                </div>
            }

            <div class="alert alert-warning">
                Nội dung chuyển khoản: <b>@Model.TopupNote</b>
            </div>

            <div class="d-flex justify-content-end">
                <button type="button" class="btn btn-primary js-close-modal">Đã hiểu</button>
            </div>
        </div>
    </div>
</div>