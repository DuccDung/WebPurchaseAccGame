@model SystemPurchaseAccGame.ViewModel.NeedTopupVm
@using System.Globalization

@{
    var vi = new CultureInfo("vi-VN");
    var urlTopupBank = Url.Action("Bank", "ClientHome") ?? "/ClientHome/Bank";
}

<div class="acc_detail_pay_modal" data-open="true" aria-hidden="false" role="dialog">
    <div class="acc_detail_pay_modalCard">
        <div class="acc_detail_pay_modalTop">
            <div class="acc_detail_pay_modalTitle">Số dư không đủ</div>
            <button class="acc_detail_pay_modalClose js-close-modal" type="button" aria-label="Đóng">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="p-3">
            <div class="mb-2"><strong>@Model.Title</strong></div>

            <div class="mb-1">
                Giá:
                <strong class="text-danger">@Model.Price.ToString("N0", vi) ₫</strong>
            </div>

            <div class="mb-1">
                Số dư ví:
                <strong>@Model.Balance.ToString("N0", vi) ₫</strong>
            </div>

            <div class="mb-3">
                Cần nạp thêm:
                <strong class="text-danger">@Model.NeedMore.ToString("N0", vi) ₫</strong>
            </div>

            <div class="alert alert-warning mb-3">
                Bạn vui lòng nạp thêm tiền vào ví để tiếp tục thanh toán.
            </div>

            <div class="d-flex gap-2 justify-content-end">
                <button class="acc_detail_pay_btn acc_detail_pay_btnGhost js-close-modal" type="button">
                    Đóng
                </button>

                <a class="acc_detail_pay_btn acc_detail_pay_btnPrimary" href="@urlTopupBank">
                    Tới trang nạp tiền
                </a>
            </div>
        </div>
    </div>
</div>