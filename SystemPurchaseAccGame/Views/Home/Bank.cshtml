@{
    Layout = "~/Views/Shared/_ClientNewLayout.cshtml";
    decimal balance = ViewBag.WalletBalance ?? 0m;
}

<div class="container py-5">
    <div class="card shadow rounded-4 p-4">

        <h3 class="fw-bold mb-3 text-primary">
            <i class="fa-solid fa-wallet me-2"></i>Nạp tiền vào ví
        </h3>

        <div class="alert alert-info mb-4">
            Số dư hiện tại:
            <b class="text-success">
                @balance.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ₫
            </b>
        </div>

        <!-- Tabs -->
        <ul class="nav nav-pills mb-4" id="topupTabs">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#card">
                    Nạp thẻ cào
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="pill" data-bs-target="#bank">
                    Chuyển khoản ngân hàng
                </button>
            </li>
        </ul>

        <div class="tab-content">

            <!-- ================= CARD ================= -->
            <div class="tab-pane fade show active" id="card">

                <form method="post" action="/client/topup/card">

                    <div class="mb-3">
                        <label class="form-label">Loại thẻ</label>
                        <select class="form-select" name="provider" required>
                            <option value="VIETTEL">VIETTEL</option>
                            <option value="VINAPHONE">VINAPHONE</option>
                            <option value="MOBIFONE">MOBIFONE</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mệnh giá</label>
                        <select class="form-select" name="amount" required>
                            <option value="10000">10.000</option>
                            <option value="20000">20.000</option>
                            <option value="50000">50.000</option>
                            <option value="100000">100.000</option>
                            <option value="200000">200.000</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mã thẻ</label>
                        <input class="form-control" name="pin" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Serial</label>
                        <input class="form-control" name="serial" required />
                    </div>

                    <button class="btn btn-primary w-100">
                        <i class="fa-solid fa-check me-1"></i>Nạp thẻ
                    </button>

                </form>
            </div>

            <!-- ================= BANK ================= -->
            <div class="tab-pane fade" id="bank">

                <div class="alert alert-warning">
                    Vui lòng chuyển khoản đúng nội dung để hệ thống tự động cộng tiền.
                </div>

                <div class="mb-3">
                    <div><b>Ngân hàng:</b> TIMO</div>
                    <div><b>Số tài khoản:</b> 9021758421767</div>
                    <div><b>Chủ tài khoản:</b> NGUYEN DINH CUONG</div>
                </div>

                <form method="post" action="/client/topup/bank">

                    <div class="mb-3">
                        <label class="form-label">Số tiền</label>
                        <input id="bankAmountView"
                               class="form-control"
                               inputmode="numeric"
                               required />
                        <input type="hidden" name="amount" id="bankAmount" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mã giao dịch</label>
                        <input class="form-control"
                               name="txn_code"
                               id="txnCode"
                               readonly />
                    </div>

                    <button class="btn btn-success w-100">
                        <i class="fa-solid fa-paper-plane me-1"></i>Gửi yêu cầu
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>
<script>
    (() => {

        const view = document.getElementById("bankAmountView");
        const hidden = document.getElementById("bankAmount");
        const txn = document.getElementById("txnCode");

        if (txn && !txn.value) {
            const ts = Date.now();
            const rnd = Math.floor(1000 + Math.random() * 9000);
            txn.value = "g" + ts + rnd;
        }

        const onlyDigits = s => (s || "").replace(/[^\d]/g, "");

        view?.addEventListener("input", () => {
            const raw = onlyDigits(view.value);
            if (!raw) {
                hidden.value = "";
                return;
            }
            const num = Number(raw);
            hidden.value = num;
            view.value = num.toLocaleString("vi-VN");
        });

    })();
</script>